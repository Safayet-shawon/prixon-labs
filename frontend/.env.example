# --- Frontend (public, baked into the bundle) ---
# Leave empty to call the same-origin /api (Vercel serverless API or the Vite dev API).
VITE_API_URL=
# Only set this to proxy /api to a separate backend such as the Spring Boot service.
# VITE_PROXY_TARGET=http://127.0.0.1:8080
# Optional: your actual WhatsApp number, including country code. Never an API secret.
VITE_WHATSAPP_NUMBER=

# --- Serverless API (server-only; set in Vercel > Settings > Environment Variables) ---
# Supabase: Project settings > API. Keep the service role key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for /admin. Use a long random value.
ADMIN_PASSWORD=
# Comma-separated exact origins allowed to call the API cross-origin (usually not needed).
CORS_ORIGINS=
# Optional e-mail notification of new enquiries through Resend.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
