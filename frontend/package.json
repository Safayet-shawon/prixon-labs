{
  "name": "praxivon-labs-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write src tests api scripts index.html vite.config.js eslint.config.js package.json ../README.md",
    "format:check": "prettier --check src tests api scripts index.html vite.config.js eslint.config.js package.json ../README.md",
    "db:seed": "node scripts/seed-supabase.mjs",
    "db:seed-sql": "node scripts/seed-supabase.mjs --sql",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run lint && npm test && npm run format:check && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.11",
    "vite": "^7.1.2"
  },
  "description": "Praxivon Labs — React + Vite frontend with a Vercel serverless API backed by Supabase.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Safayet-shawon/prixon-labs.git",
    "directory": "frontend"
  },
  "engines": {
    "node": ">=20"
  }
}
