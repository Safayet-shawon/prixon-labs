# Local backend settings. Leave SMTP values blank until real credentials are available.
PORT=8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_TO=
CONTACT_FROM=
# The Vite proxy makes browser requests same-origin; this is for direct cross-origin API access.
CORS_ORIGINS=http://127.0.0.1:5173
